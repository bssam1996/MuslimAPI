        {
          "refId": "A",
          "expr": "sum by (status) (rate(muslim_api_http_requests_total{job=\"muslim-api\",route!=\"/\",route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
