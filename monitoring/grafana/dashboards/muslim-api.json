        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(muslim_api_http_request_duration_seconds_bucket{job=\"muslim-api\",route!=\"/\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "HTTP latency histogram",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(muslim_api_http_request_duration_seconds_bucket{job=\"muslim-api\",route!=\"/\",route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "legend": {
          "show": true
        },
        "yAxis": {
          "unit": "s",
          "min": "0"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        }
      },
      "description": "Distribution of request durations over time. Health probes are excluded. Prometheus cumulative buckets are converted into interval buckets by the datasource."
    },
    {
      "id": 10,
      "title": "Function latency p95 by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, function, outcome) (rate(muslim_api_function_duration_seconds_bucket{job=\"muslim-api\",function=~\"$function\"}[$__rate_interval])))",
          "legendFormat": "{{function}} [{{outcome}}]",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Inclusive wall time, including awaited work. Nested function durations overlap; do not add them together."
    },
    {
      "id": 11,
      "title": "Function calls: success / error / cancelled",
      "type": "timeseries",
      "datasource": {
