# Copy this file to .env. Do not commit the populated .env file.
# Use muslim-api:local for local builds, or the GHCR image for the mini PC:
# MUSLIM_API_IMAGE=ghcr.io/bssam1996/muslimapi:latest
MUSLIM_API_IMAGE=muslim-api:local
PORT=8000
# Use 127.0.0.1 if a reverse proxy on this machine will expose the API.
BIND_ADDRESS=0.0.0.0

# Optional Prometheus + Grafana stack (compose.monitoring.yaml).
# Set a strong password before starting the monitoring stack.
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ADMIN_USER=admin
# GRAFANA_PORT=3000
# GRAFANA_BIND_ADDRESS=0.0.0.0
# PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=15d
# PROMETHEUS_RETENTION_SIZE=2GB
