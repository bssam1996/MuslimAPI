      "description": "Includes returned HTTP 4xx/5xx and expected validation exceptions as well as unexpected failures. Use HTTP 5xx to measure server failures."
    },
    {
      "id": 13,
      "title": "Request / response body size (mean)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(muslim_api_http_request_body_bytes_sum{job=\"muslim-api\",route=~\"$route\",route!=\"/\"}[$__rate_interval])) / clamp_min(sum(rate(muslim_api_http_request_body_bytes_count{job=\"muslim-api\",route=~\"$route\",route!=\"/\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "request",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(muslim_api_http_response_body_bytes_sum{job=\"muslim-api\",route=~\"$route\",route!=\"/\"}[$__rate_interval])) / clamp_min(sum(rate(muslim_api_http_response_body_bytes_count{job=\"muslim-api\",route=~\"$route\",route!=\"/\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "response",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "options": {
        "legend": {
