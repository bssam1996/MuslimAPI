# Use durable PostgreSQL in production, including on Vercel.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_ORIGINS=https://bssam1996.github.io
VAPID_PUBLIC_KEY=generated-public-key
# Raw URL-safe base64 private scalar from scripts/generate_push_keys.py
VAPID_PRIVATE_KEY=generated-private-key
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=generate-a-random-secret-of-at-least-32-characters

# Local testing only: unset DATABASE_URL and set PUSH_DATABASE instead.
# PUSH_DATABASE=data/web_push/push.sqlite3
